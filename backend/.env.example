# ─── Relayer Wallet ───────────────────────────────────────────────────────────
# Funded EVM wallet private key — NEVER commit the real value to git
RELAYER_PRIVATE_KEY=0x_your_funded_wallet_private_key_here

# ─── RPC / Chain ──────────────────────────────────────────────────────────────
RPC_URL=https://ethereum-sepolia.publicnode.com
CHAIN_ID=11155111

# ─── Contract Addresses ───────────────────────────────────────────────────────
FHE_NOAH_REGISTRY_ADDRESS=0xd6ACEA76AAF465559Ff9F287b4F883f18368325B
FHE_ACCESS_CONTROL_ADDRESS=0x503De26148ACa67Aa97E12eC545B22e7216f1BE4

# ─── API Security ─────────────────────────────────────────────────────────────
# Shared secret sent in X-API-Key header by integrators
API_KEY=change_me_to_a_secure_random_string_min_32_chars

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Relayer Health ───────────────────────────────────────────────────────────
# Minimum ETH balance before a warning is emitted (in ETH, e.g. 0.05)
RELAYER_MIN_BALANCE_ETH=0.05
